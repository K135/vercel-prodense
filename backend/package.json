{
  "name": "prodance-backend",
  "version": "1.0.0",
  "description": "Backend API for Prodance application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:local": "NODE_ENV=development node -r dotenv/config server.js dotenv_config_path=.env.local",
    "test": "node test/api-test.js",
    "db:init": "node scripts/initLocalDB.js",
    "db:migrate": "node scripts/migrateFromAtlas.js",
    "db:migrate:keep": "node scripts/migrateFromAtlas.js --keep-backup",
    "db:view": "node scripts/dbViewer.js",
    "db:stats": "node scripts/dbManager.js stats",
    "db:clear": "node scripts/dbManager.js clear",
    "db:export": "node scripts/dbManager.js export",
    "db:backup": "node scripts/dbManager.js backup",
    "db:import": "node scripts/dbManager.js import"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "sharp": "^0.32.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "authentication",
    "api"
  ],
  "author": "Prodance Team",
  "license": "MIT"
}
